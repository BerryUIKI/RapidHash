# 通用领域术语、校验状态与共享消息

app-name = RapidHash

# 校验状态
verification-status-match = 匹配
    .description = 计算出的校验和与预期摘要完全一致。
verification-status-mismatch = 不匹配
    .description = 计算出的校验和与预期摘要不一致。
verification-status-missing = 缺失
    .description = 目标文件不存在。
verification-status-unreadable = 无法读取
    .description = 目标文件存在但无法读取。
verification-status-malformed = 格式错误
    .description = 校验和条目或清单记录无效。
verification-status-unsupported = 不支持
    .description = 不支持所请求的算法或格式。
verification-status-cancelled = 已取消
    .description = 操作已由用户停止。

# 通用操作与控件
action-cancel = 取消
action-retry = 重试
action-copy = 复制
action-close = 关闭

# 通用提示与安全指引
notice-checksum-not-authenticity = 校验和匹配仅验证完整性，不代表文件安全或来源可信。
